{
  "name": "study-timer-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:pages": "opennextjs-cloudflare build && node -e \"const fs=require('fs');fs.mkdirSync('.vercel/output',{recursive:true});fs.rmSync('.vercel/output/static',{recursive:true,force:true});fs.cpSync('.open-next/assets','.vercel/output/static',{recursive:true});\"",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint",
    "migrate:firestore:mongo": "tsx scripts/migrate/firestore-to-mongodb.ts",
    "mongo:indexes": "tsx scripts/migrate/mongo-create-indexes.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@opennextjs/cloudflare": "^1.14.0",
    "@aws-sdk/client-s3": "^3.888.0",
    "@aws-sdk/s3-request-presigner": "^3.888.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.4.0",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.576.0",
    "mongoose": "^8.18.0",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "prisma": "^5.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-easy-crop": "^5.5.6",
    "recharts": "^3.7.0",
    "uuid": "^13.0.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "wrangler": "^4.8.0"
  }
}
